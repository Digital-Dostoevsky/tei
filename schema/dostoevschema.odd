<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml"
	schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="en" 
  xmlns:sch="http://purl.oclc.org/dsdl/schematron">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Dostoevschema, the ODD for Computational Dostoevsky</title>
        <author>Katherine Bowers</author>
        <author>Kate Holland</author>
        <author>Joey Takeda</author>
        <author>Braxton Boyer</author>
      </titleStmt>
      
      <!-- Change the publicationStmt and sourceDesc -->
      <publicationStmt xml:id="dd-pubStmt">
        <publisher>Digital Dostoevsky</publisher>
        <pubPlace>Toronto, Ontario</pubPlace>
        <address>
          <addrLine>Department of Slavic Languages and Literatures</addrLine>
          <addrLine>University of Toronto</addrLine>
        </address>
        <availability status="free">
          <!--TODO: Update with whatever license is correct-->
          <licence target="http://creativecommons.org/licenses/by-sa/3.0/">Distributed under a Creative Commons
            Attribution-ShareAlike 3.0 Unported License </licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital; created by Computation Dostoevsky team.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <!-- Not sure what a lot of this stuff in <front> and <body> is. 
    Could this information be moved up to the <fileDesc> somewhere? The title information, <docAuthor>, General Overview, History of the Project, etc. Also, does <schemaSpec> need to go in <body>? -->
  <text>
    <front>
      <titlePage>
        <docTitle>
          <titlePart type="main">Dostoevschema</titlePart>
          <titlePart type="sub">Schema and guidelines for Computational Dostoevsky</titlePart>
        </docTitle>
        <docAuthor></docAuthor>
      </titlePage>
      <p>This documentation describes the schema and encoding guidelines (<soCalled>Dostoevschema</soCalled>) for the Computational Dostoevsky project.</p>
      <divGen type="toc"/>
    </front>
    <body>
      <head>Dostoevschema</head>
      
      <div>
        <head>General Overview</head>
      </div>
      
      <div>
        <head>History of the Project</head>
        <p></p>
      </div>
      
      <div>
        <head>Encoding Practices</head>
        <div>
          <head>Automated Tagging</head>
          <p>Primarily automated tagging dealt with structural elements:
            <specList>
              <specDesc key="div1"/>
              <specDesc key="div2"/>
              <specDesc key="div3"/>
            </specList>
          
          </p>
        </div>
        <div>
          <head>Speech</head>
          <p>Speech is encoded using the <gi>said</gi> element:
            <specList>
              <specDesc key="said" atts="who toWhom aloud direct"/>
            </specList>
          
          </p>
          
         </div>
      </div>
      
    </body>
    <back>
      <!--NOTE (JT, 2026-06-29): There is currently a bug with
          TEI >= 4.10.0 where a schematron abstract pattern is not
          included and thus breaks the output schema, which is why
          we specify 4.9.0 as the base schema for now. -->
      <schemaSpec ident="dostoevschema" start="TEI" prefix="tei_" targetLang="en" docLang="en"
        source="tei:4.9.0">
        
        <!--*************************************
            MODULE: core
            *************************************-->
        <moduleRef key="core"
          include="addrLine address author biblStruct date editor emph
          foreign head hi imprint item l lb lg list milestone
          monogr name note p ptr pubPlace publisher q quote resp
          respStmt rs said title"/>

        
        <!--TODO:
            Constrain addName to a small subset of types (closed list)
            and probably remove the @ref attribute to avoid confusion -->
        
        <!--*************************************
            MODULE: header
            *************************************-->
        <moduleRef key="header"
          include="biblFull change creation fileDesc funder langUsage
          language principal profileDesc publicationStmt revisionDesc
          sourceDesc teiHeader titleStmt"/>
        
        <elementSpec ident="revisionDesc" mode="change" module="header">
          <content>
            <elementRef key="change" minOccurs="1" maxOccurs="unbounded"/>
          </content>
        </elementSpec>
        
        
        <elementSpec ident="change" mode="change" module="header">
          <classes mode="change">
            <memberOf key="att.global" mode="delete"/>
            <memberOf key="att.docStatus" mode="delete"/>
            <memberOf key="att.typed" mode="delete"/>
          </classes>
          <constraintSpec mode="add" scheme="schematron" ident="change.alwaysChronological">
            <desc>Change elements in revisionDesc should always follow reverse chronological order.</desc>
            <constraint>
              <sch:rule context="tei:change[following-sibling::tei:change]">
                <sch:let name="when" value="xs:date(@when)"/>
                <sch:let name="nextWhen" 
                  value="xs:date(following-sibling::tei:change[1]/@when)"/>
                <sch:assert test="not($when lt $nextWhen)">ERROR: All change elements should be listed in chronological order.</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <attDef ident="target" mode="delete"/>
            <attDef ident="who" usage="req" mode="change"/>
            <attDef ident="when" usage="req" mode="change"/>
            <attDef ident="period" mode="delete"/>
            <attDef ident="when-custom" mode="delete"/>
          </attList>
        </elementSpec>
        
        <!--*************************************
            MODULE: linking
            *************************************-->
        
        <moduleRef key="linking" include="seg standOff"/>
        
        
        <!--*************************************
            MODULE: namesdates
            *************************************-->
        <moduleRef key="namesdates"
          include="addName forename listObject listPerson listPlace
          object objectIdentifier objectName orgName persName
          person personGrp place placeName roleName state surname"/>
        
        <elementSpec ident="person" mode="change" module="namesdates">
          <content>
            <sequence>
              <elementRef key="persName" minOccurs="1" maxOccurs="unbounded"/>
              <elementRef key="note" minOccurs="0"/>
            </sequence>
          </content>
          <attList>
            <attDef ident="xml:id" usage="req" mode="change"/>
            <!--TODO: Update usage to req once all errors/
              values have been resolved-->
            <attDef ident="sex" usage="rec" mode="change"/>
          </attList>
        </elementSpec>
        
        <!-- Constrains `<addName>` to a closed list of `@type` values.
        Would it be better to do a `<constraintSpec>` for this?-->
        <elementSpec ident="addName" mode="change" module="namesdates">
          <attList>
            <attDef ident="type" mode="change">
              <!--TODO: Update type to be closed
              once all errors resolved-->
              <valList mode="replace" type="semi">
                <valItem ident="patronymic">
                  <gloss>patronymic</gloss>
                  <desc>the patronymic of a character's name</desc>
                </valItem>
                <valItem ident="diminutive">
                  <gloss>diminutive</gloss>
                  <desc>the diminutive version of a character's name, for example "Mitya" for "Dmitry."</desc>
                </valItem>
                <valItem ident="nickname">
                  <gloss>nickname</gloss>
                  <desc>a name given to a character by another character</desc>
                </valItem>
                <valItem ident="epithet">
                  <gloss>epithet</gloss>
                  <desc>a name given to a character by the narrator, for example "our hero" for Golyadkin in The Double</desc>
                </valItem>
              </valList>
            </attDef>
          </attList>
        </elementSpec>
        
        
<!--       A possible `<constraintSpec>` for `<addName>` if this would be better?
          
          <constraintSpec mode="add" scheme="schematron" ident="addName.certainTypesOnly">
          <desc>Constrain addName/@type to enforce proper encoding of names</desc>
          <constraint>
            <sch:rule context="tei:addName">
              <sch:assert test="@type = ('patronymic','diminutive','nickname', 'epithet')">
                ERROR: The @type attribute on addName must be one of: patronymic, diminutive, nickname, or epithet.
              </sch:assert>
            </sch:rule>
          </constraint>
        </constraintSpec>-->
        

          
        
        <!--*************************************
            MODULE: spoken
            *************************************-->
        <moduleRef key="spoken" include="shift writing"/>
        
        <!--*************************************
            MODULE: tei
            
            Include everything from the TEI module,
            including attribute classes, model classes,
            datatypes, and macros
            *************************************-->
        <moduleRef key="tei"/>
        
        
        <!--*************************************
            MODULE: textstructure
            *************************************-->
        <moduleRef key="textstructure"
          include="TEI back body div div1 div2 div3 epigraph front text"/>
        
        <elementSpec ident="div" module="textstructure" mode="change">
          <constraintSpec mode="add" scheme="schematron" ident="div.nestTypesProperly">
            <desc>Constrain div/@type to enforce the proper hierarchy (parts, then chapters, then sections).</desc>
            <constraint>
              
              <sch:rule context="tei:div[@type][ancestor::tei:div[@type]]">
                <sch:let name="allTypes" value="('part','chapter','section')"/>
                <sch:let name="currType" value="@type"/>
                <sch:let name="ancestorDivType"
                  value="ancestor::tei:div[@type][1]/@type"/>
                <sch:let name="currIdx" 
                  value="index-of($allTypes, $currType)"/>
                <sch:let name="ancestorIdx" 
                  value="index-of($allTypes, $ancestorDivType)"/>
                <sch:assert test="$ancestorIdx lt $currIdx">ERROR: Types of divisions must nest properly (<sch:value-of select="string-join($allTypes,', ')"/>).</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <attDef ident="type" mode="change" usage="req">
              <valList mode="add" type="closed">
                <valItem ident="part" mode="add">
                  <gloss>part</gloss>
                  <desc>The larger section, usually containing chapters (formerly <gi>div1</gi>).</desc>
                </valItem>
                <valItem ident="chapter" mode="add">
                  <gloss>chapter</gloss>
                  <desc>The chapter, usually containing sections (formerly <gi>div2</gi>)</desc>
                </valItem>
                <valItem ident="section" mode="add">
                  <gloss>section, formerly <gi>div3</gi></gloss>
                </valItem>
              </valList>
            </attDef>
          </attList>
        </elementSpec>
        
        <!--*************************************
            MODULE: verse
            *************************************-->
        <moduleRef key="verse" include="att.metrical"/>
        
     
      </schemaSpec>
    </back>
  </text>
</TEI>